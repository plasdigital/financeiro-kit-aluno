# Copie este arquivo para .env.local e preencha. NUNCA versione o .env.local.
#
# Passo a passo de onde sai cada valor: COMECE-AQUI.md.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings > Database > Connection string > "Transaction pooler" (porta 6543).
# Troque [YOUR-PASSWORD] pela senha do banco que voce definiu ao criar o projeto.
SUPABASE_DB_URL="postgresql://postgres.<REF_DO_SEU_PROJETO>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# ── Pluggy ──────────────────────────────────────────────────────────────────
# Os rotulos dos titulares, separados por virgula. Um titular = uma conta no Meu Pluggy.
# Quem conecta so os proprios bancos deixa "principal".
PLUGGY_TITULARES="principal"

# dashboard.pluggy.ai > Applications > a sua aplicacao
PLUGGY_PRINCIPAL_CLIENT_ID=""
PLUGGY_PRINCIPAL_CLIENT_SECRET=""

# Um itemId por BANCO conectado (nao por conta), separados por virgula.
# Dashboard > a sua aplicacao > "Ir para Demo" > menu de tres pontos > "Copiar Item ID".
PLUGGY_PRINCIPAL_ITEMS=""

# Um segundo titular (outra pessoa da casa, com o Meu Pluggy dela) seria:
#   PLUGGY_TITULARES="principal,segundo"
#   PLUGGY_SEGUNDO_CLIENT_ID="" / PLUGGY_SEGUNDO_CLIENT_SECRET="" / PLUGGY_SEGUNDO_ITEMS=""
